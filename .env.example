# Directus API URL
VITE_DIRECTUS_URL=https://your-directus-url

# Admin role ID
VITE_ADMIN_ROLE_ID=bace44bc-43ab-47c9-af98-2f4c154d6768

# File folder
VITE_FILE_FOLDER=dcea2d36-7cec-4479-bbd6-d5a54e432d9d

# Nginx server name
NGINX_SERVER_NAME=your-domain.com

# Let's encrypt email
LETSENCRYPT_EMAIL=your-email@example.com

# Frontend public port
FRONTEND_PUBLIC_PORT=8080

# Secret key for encrypting/decrypting auto-login credentials
VITE_ENCRYPTION_SECRET=your-secret-key

# Enable username to email feature (true/false)
VITE_ENABLE_USERNAME_TO_EMAIL=false

# Default email domain to append to usernames when not an email
VITE_DEFAULT_EMAIL_DOMAIN=example.com

# Video Configuration
# Video 1 - Church History
VITE_VIDEO_1_TITLE=100 Jahre Geschichte
VITE_VIDEO_1_DESCRIPTION=Entdecken Sie die bewegende Geschichte unserer Gemeinde
VITE_VIDEO_1_THUMBNAIL=https://example.com/thumbnails/geschichte.jpg
VITE_VIDEO_1_URL=https://example.com/streams/geschichte.m3u8

# Video 2 - Upload Tutorial  
VITE_VIDEO_2_TITLE=Wie funktioniert das Einreichen?
VITE_VIDEO_2_DESCRIPTION=An einem Beispiel wird gezeigt, wie man das Formular ausfüllt.
VITE_VIDEO_2_THUMBNAIL=https://example.com/thumbnails/anleitung.jpg
VITE_VIDEO_2_URL=https://example.com/streams/anleitung.m3u8

# You can add more videos by incrementing the number:
# VITE_VIDEO_3_TITLE=...
# VITE_VIDEO_3_DESCRIPTION=...
# VITE_VIDEO_3_THUMBNAIL=...
# VITE_VIDEO_3_URL=...

# For regular MP4 videos instead of HLS streams:
# VITE_VIDEO_1_URL=https://example.com/videos/geschichte.mp4

# For local files (place in public/ directory):
# VITE_VIDEO_1_THUMBNAIL=/thumbnails/geschichte.jpg
# VITE_VIDEO_1_URL=/videos/geschichte.mp4
